ENVIRONMENT=local
PROJECT_NAME=tmx-enterprise-ai-reference-platform
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO
# Comma-separated allowed CORS origins for the Web app — never "*" (PBI-04-02). Default matches
# docker-compose's local Web preview port.
CORS_ALLOWED_ORIGINS=http://localhost:3000
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# LLM_PROVIDER: mock (default, no external calls) | azure_openai | ollama
LLM_PROVIDER=mock
# Only read when LLM_PROVIDER=ollama. If the API runs in Docker and Ollama runs on the
# Windows/Mac host, use http://host.docker.internal:11434 instead (see docker-compose.yml).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60
SECRET_PROVIDER=environment
KEY_VAULT_URI=
CONVERSATION_STORE_PROVIDER=in_memory
COSMOS_DB_ENDPOINT=
COSMOS_DB_DATABASE=tmxap-conversation-db
COSMOS_DB_CONTAINER=conversations
KNOWLEDGE_PROVIDER=local
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_INDEX_NAME=
AZURE_AI_SEARCH_USE_API_KEY=false
TOOL_CALLING_MAX_ITERATIONS=3
ENABLE_API_MANAGEMENT=false
# Microsoft Entra ID end-user authentication (PBI-11-01) — distinct from AZURE_TENANT_ID/
# AZURE_CLIENT_ID above, which are DefaultAzureCredential's own service-to-service identity
# (Managed Identity, Azure OpenAI/Cosmos/etc.), not end-user sign-in. None of these values are
# secrets (a SPA client ID, an authority URL, and a token audience are all meant to be public);
# the API never holds a client secret for this flow. Defaults match the confirmed DEV App
# Registration — override per environment only if a different App Registration is used.
ENTRA_AUTHORITY=https://login.microsoftonline.com/common
ENTRA_CLIENT_ID=67d95215-5a31-416a-99ab-5fe203fb7c32
# PBI-11-01D: the bare API client ID GUID — confirmed live against a real v2.0 access token
# (ver=2.0). NOT "api://67d95215-.../access_as_user" — that is the frontend's requested
# scope/resource identifier (apps/web's loginRequest.ts), not this v2.0 token's `aud` claim.
ENTRA_API_AUDIENCE=67d95215-5a31-416a-99ab-5fe203fb7c32
