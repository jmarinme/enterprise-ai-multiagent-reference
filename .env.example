ENVIRONMENT=local
PROJECT_NAME=tmx-enterprise-ai-reference-platform
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# LLM_PROVIDER: mock (default, no external calls) | azure_openai | ollama
LLM_PROVIDER=mock
# Only read when LLM_PROVIDER=ollama. If the API runs in Docker and Ollama runs on the
# Windows/Mac host, use http://host.docker.internal:11434 instead (see docker-compose.yml).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60
SECRET_PROVIDER=environment
KEY_VAULT_URI=
CONVERSATION_STORE_PROVIDER=in_memory
COSMOS_DB_ENDPOINT=
COSMOS_DB_DATABASE=tmxap-conversation-db
COSMOS_DB_CONTAINER=conversations
KNOWLEDGE_PROVIDER=local
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_INDEX_NAME=
AZURE_AI_SEARCH_USE_API_KEY=false
TOOL_CALLING_MAX_ITERATIONS=3
ENABLE_API_MANAGEMENT=false
