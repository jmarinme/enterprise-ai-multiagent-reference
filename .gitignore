# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets/
.local/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/

# Node
node_modules/
dist/
build/
coverage/
.pnpm-store/

# IDE / OS
.DS_Store
Thumbs.db
.vscode/*.log

# Azure / IaC generated
*.parameters.json
ops/bicep/**/*.json
.azure/
bin/
obj/

# Azure Functions build output (PBI-06-01): build.ps1 vendors repo-root src/ into each
# ops/functions/<app>/ directory so the deployment package can `import src.*` — never commit
# the vendored copy, it would duplicate the one real src/ tree (CLAUDE.md §6).
ops/functions/*/src/
ops/functions/*/*.zip
ops/functions/*/local.settings.json

# Test and runtime output
reports/*
!reports/.gitkeep
artifacts/*
!artifacts/.gitkeep
*.log

# Notebooks
.ipynb_checkpoints/

# Sensitive or real business data
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
