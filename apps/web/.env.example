VITE_API_URL=http://localhost:8000
# Microsoft Entra ID authentication (PBI-11-01). None of these are secrets — a SPA client ID,
# an authority URL, and an API scope/Application ID URI are all meant to be public. Defaults
# (apps/web/src/config/env.ts) already match the confirmed DEV App Registration, so these are
# optional overrides, not required for local dev against DEV's own App Registration.
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common
VITE_ENTRA_CLIENT_ID=67d95215-5a31-416a-99ab-5fe203fb7c32
VITE_ENTRA_API_SCOPE=api://67d95215-5a31-416a-99ab-5fe203fb7c32/access_as_user
# PBI-11-01B: must be the dedicated MSAL redirect-bridge page, not the SPA root — see
# src/auth-bridge.ts. Leave unset to default to <this app's own origin>/auth-bridge.html; only
# set this if the registered bridge redirect URI differs from that.
VITE_ENTRA_REDIRECT_URI=
# Where the user lands after signing out — leave unset to default to the app's own origin
# (never the bridge page above, which has no UI).
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=
